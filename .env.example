# Copy to .env  (never commit real keys)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- LLM (free tiers). Without keys the app still runs: extraction/chat need a key, the demo data does not.
LLM_PROVIDER=groq          # groq | gemini | fake (offline, scripted - tests only)
GROQ_API_KEY=
GOOGLE_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite

# --- models (docker build arg INSTALL_ML=0 -> use the offline stand-ins below)
OCR_ENGINE=doctr           # doctr | fake
EMBEDDER=st                # st (MiniLM) | hash
RERANKER=ce                # ce (cross-encoder) | overlap

# --- demo
DEMO_EMAIL=demo@docsense.dev
DEMO_PASSWORD=docsense-demo-2025

# --- integrations
WEBHOOKS_ALLOW_PRIVATE=0       # 1 only for local n8n on localhost
PUBLIC_APP_URL=http://localhost:5173
