{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,seed/**,deploy/demo.db}",
      "excludeFiles": "{frontend/**,ml/**,docs/**,scripts/**,n8n/**,.github/**,backend/.venv/**,backend/**/tests/**,backend/*media*/**,backend/*.sqlite3}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
